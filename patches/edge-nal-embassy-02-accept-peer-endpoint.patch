Fix TcpAccept peer endpoint.

TcpAccept::accept was returning local_endpoint(), which yields the
bound server address instead of the connecting peer; this silently
disables IP-based allow-listing at the handler since every accepted
connection reports the same server address. After a successful
accept the socket is ESTABLISHED so remote_endpoint() is always
Some. Upstream PR pending; see
patches/edge-nal-embassy-peer-endpoint.md.

diff --git a/src/tcp.rs b/src/tcp.rs
--- a/src/tcp.rs
+++ b/src/tcp.rs
@@ -105,9 +105,12 @@
             .accept(to_emb_bind_socket(self.local).ok_or(TcpError::UnsupportedProto)?)
             .await?;
 
-        let local_endpoint = unwrap!(socket.socket.local_endpoint());
+        // Return the peer's address so callers can inspect the remote IP.
+        // The original code called local_endpoint(), which returns the bound
+        // server address and defeats any IP-based filtering at the handler.
+        let remote_endpoint = unwrap!(socket.socket.remote_endpoint());
 
-        Ok((to_net_socket(local_endpoint), socket))
+        Ok((to_net_socket(remote_endpoint), socket))
     }
 }
 
