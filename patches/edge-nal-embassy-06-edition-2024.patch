Bump the crate to Rust edition 2024.

Wraps the unsafe ops in unsafe blocks for the 2024
unsafe-op-in-unsafe-fn lint, matching the edition bump of the
consuming workspace.

diff --git a/Cargo.toml b/Cargo.toml
index 898feb00..ed32559e 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -1,7 +1,7 @@
 [package]
 name = "edge-nal-embassy"
 version = "0.8.1"
-edition = "2021"
+edition = "2024"
 rust-version = "1.91"
 description = "An implementation of edge-nal based on `embassy-net`"
 repository = "https://github.com/ivmarkov/edge-net"
diff --git a/src/lib.rs b/src/lib.rs
index 11e55b24..e46cf142 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -66,7 +66,7 @@ mod sealed {
         }
 
         unsafe fn free(&self, buffer_token: NonNull<u8>) {
-            (**self).free(buffer_token)
+            unsafe { (**self).free(buffer_token) }
         }
     }
 }
@@ -118,7 +118,7 @@ impl<T, const N: usize> Pool<T, N> {
     /// - `p`: A pointer to the object to free.
     unsafe fn free(&self, p: NonNull<T>) {
         let origin = self.data.as_ptr() as *mut T;
-        let n = p.as_ptr().offset_from(origin);
+        let n = unsafe { p.as_ptr().offset_from(origin) };
         assert!(n >= 0);
         assert!((n as usize) < N);
         self.used[n as usize].set(false);
