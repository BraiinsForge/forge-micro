Rewrite the manifest for standalone consumption.

The workspace-inherited dependency table only resolves inside the
edge-net workspace; a detached copy of the crate has no parent
workspace, so the deps become explicit versions matching the
edge-net pin, with edge-nal kept on the same pinned rev so the
whole edge-net family resolves to one source.

diff --git a/Cargo.toml b/Cargo.toml
index e7baeaaa..992aa6b3 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -22,13 +22,13 @@ io = ["embedded-io-async", "edge-nal", "embassy-sync", "embassy-futures"]
 defmt = ["dep:defmt", "heapless/defmt"]
 
 [dependencies]
-log = { workspace = true, default-features = false, optional = true }
-defmt = { workspace = true, default-features = false, optional = true }
-embedded-io-async = { workspace = true, optional = true }
-edge-nal = { workspace = true, optional = true }
-heapless = { workspace = true }
-httparse = { workspace = true, default-features = false }
-base64 = { workspace = true, default-features = false }
-sha1_smol = { workspace = true, default-features = false }
-embassy-sync = { workspace = true, optional = true }
-embassy-futures = { workspace = true, optional = true }
+log = { version = "0.4", default-features = false, optional = true }
+defmt = { version = "1", default-features = false, features = ["ip_in_core"], optional = true }
+embedded-io-async = { version = "0.7", default-features = false, optional = true }
+edge-nal = { git = "https://github.com/ivmarkov/edge-net", rev = "1f084b41944c35b233cbe17accfbc09a56d5eaf0", default-features = false, optional = true }
+heapless = { version = "0.9", default-features = false }
+httparse = { version = "1.10", default-features = false }
+base64 = { version = "0.22", default-features = false }
+sha1_smol = { version = "1", default-features = false }
+embassy-sync = { version = "0.8", default-features = false, optional = true }
+embassy-futures = { version = "0.1.2", default-features = false, optional = true }
