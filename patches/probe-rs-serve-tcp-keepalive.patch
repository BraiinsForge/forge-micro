+/// Wraps the accept loop so every accepted client connection gets TCP
+/// keepalive enabled.
+///
+/// A client that dies abruptly (a `kill -9`, a yanked cable, a crash) never
+/// sends a FIN, so the per-connection reader future in `handle_socket` blocks
+/// forever on `reader.next()`, the `select!` never resolves, and the `Session`
+/// it holds — and the debug probe behind it — is never released. The next
+/// client then fails to open the probe with "interface is busy". Keepalive
+/// makes the kernel reap the half-open socket, which ends the reader future
+/// and runs the existing disconnect cleanup.
+struct KeepaliveListener(tokio::net::TcpListener);
+
+impl axum::serve::Listener for KeepaliveListener {
+    type Io = tokio::net::TcpStream;
+    type Addr = std::net::SocketAddr;
+
+    async fn accept(&mut self) -> (Self::Io, Self::Addr) {
+        loop {
+            match self.0.accept().await {
+                Ok((stream, addr)) => {
+                    let keepalive = TcpKeepalive::new()
+                        .with_time(Duration::from_secs(15))
+                        .with_interval(Duration::from_secs(5))
+                        .with_retries(3);
+                    // Best effort: the probe still works without keepalive, it
+                    // just leaks the session on an abrupt client disconnect.
+                    if let Err(error) = SockRef::from(&stream).set_tcp_keepalive(&keepalive) {
+                        tracing::warn!("failed to enable TCP keepalive: {error}");
+                    }
+                    return (stream, addr);
+                }
+                // Mirror axum's own TcpListener accept: log transient accept
+                // errors and retry rather than tear the whole server down.
+                Err(error) => {
+                    tracing::debug!("accept error: {error}");
+                    tokio::time::sleep(Duration::from_millis(50)).await;
+                }
+            }
+        }
+    }
+
+    fn local_addr(&self) -> std::io::Result<Self::Addr> {
+        self.0.local_addr()
+    }
+}
